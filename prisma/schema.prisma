generator client {
  provider = "prisma-client-js"
}

datasource db { provider = "postgresql" }

enum Role { OWNER ADMIN MARKETING SALES SUPPORT VIEWER }

enum DealStage { NEW CONTACTED QUALIFIED PROPOSAL NEGOTIATION WON LOST }

enum ActivityType { CALL EMAIL WHATSAPP MEETING NOTE TASK CAMPAIGN }

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
}

model Business {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  memberships Membership[]
  contacts Contact[]
  companies Company[]
  deals Deal[]
  activities Activity[]
  campaigns Campaign[]
  accounts ChannelAccount[]
  templates MessageTemplate[]
  segments AudienceSegment[]
  flows ChatbotFlow[]
  forms WhatsAppForm[]
  integrations Integration[]
  ads AdCampaign[]
  prospects BusinessProspect[]
}

model Membership {
  id String @id @default(cuid())
  userId String
  businessId String
  role Role @default(VIEWER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  contacts Contact[]
  deals Deal[]
  activities Activity[]
  @@unique([userId, businessId])
  @@index([businessId])
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model Company {
  id String @id @default(cuid())
  businessId String
  name String
  industry String?
  website String?
  phone String?
  email String?
  city String?
  region String?
  country String?
  postalCode String?
  lat Float?
  lng Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts Contact[]
  deals Deal[]
  @@index([businessId])
  @@index([city, region])
}

model Contact {
  id String @id @default(cuid())
  businessId String
  companyId String?
  assignedToMembershipId String?
  phone String?
  email String?
  firstName String?
  lastName String?
  companyName String?
  city String?
  region String?
  country String?
  postalCode String?
  lat Float?
  lng Float?
  consent Boolean @default(false)
  consentSource String?
  consentAt DateTime?
  optedOutAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedToMembership Membership? @relation(fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  campaigns CampaignContact[]
  deals Deal[]
  activities Activity[]
  conversations Conversation[]
  calls Call[]
  @@index([businessId])
  @@index([phone])
  @@index([email])
  @@index([city, region])
}

model Deal {
  id String @id @default(cuid())
  businessId String
  contactId String?
  companyId String?
  ownerMembershipId String?
  name String
  value Float @default(0)
  currency String @default("INR")
  stage DealStage @default(NEW)
  probability Int @default(10)
  expectedClose DateTime?
  nextActivityAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner Membership? @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  activities Activity[]
  @@index([businessId, stage])
}

model Activity {
  id String @id @default(cuid())
  businessId String
  contactId String?
  dealId String?
  ownerMembershipId String?
  type ActivityType
  subject String
  body String?
  dueAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner Membership? @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  @@index([businessId, createdAt])
}

model Campaign {
  id String @id @default(cuid())
  businessId String
  name String
  channel String
  message String @default("")
  status String @default("draft")
  scheduledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contacts CampaignContact[]
  metrics CampaignMetric[]
  @@index([businessId])
}

model CampaignContact {
  id String @id @default(cuid())
  campaignId String
  contactId String
  status String @default("queued")
  sentAt DateTime?
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@unique([campaignId, contactId])
}

model CampaignMetric {
  id String @id @default(cuid())
  campaignId String
  delivered Int @default(0)
  read Int @default(0)
  clicked Int @default(0)
  replied Int @default(0)
  converted Int @default(0)
  createdAt DateTime @default(now())
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([campaignId])
}

model ChannelAccount {
  id String @id @default(cuid())
  businessId String
  channel String
  name String
  externalId String?
  secretEncrypted String?
  enabled Boolean @default(true)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model Conversation {
  id String @id @default(cuid())
  businessId String
  contactId String?
  channel String
  externalId String?
  status String @default("open")
  assignedToMembershipId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  @@index([businessId])
}

model Call {
  id String @id @default(cuid())
  businessId String
  contactId String?
  direction String
  status String
  duration Int?
  recordingUrl String?
  notes String?
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  @@index([businessId, createdAt])
}

model Automation {
  id String @id @default(cuid())
  businessId String
  name String
  trigger String
  action String
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model MessageTemplate {
  id String @id @default(cuid())
  businessId String
  name String
  category String
  language String @default("en")
  body String
  status String @default("draft")
  buttons Json?
  mediaUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model AudienceSegment {
  id String @id @default(cuid())
  businessId String
  name String
  rules Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model ChatbotFlow {
  id String @id @default(cuid())
  businessId String
  name String
  status String @default("draft")
  trigger String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nodes ChatbotNode[]
  @@index([businessId])
}

model ChatbotNode {
  id String @id @default(cuid())
  flowId String
  type String
  config Json
  position Json?
  flow ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  @@index([flowId])
}

model WhatsAppForm {
  id String @id @default(cuid())
  businessId String
  name String
  description String?
  fields Json
  submitAction String?
  status String @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model Integration {
  id String @id @default(cuid())
  businessId String
  provider String
  name String
  config Json?
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model AdCampaign {
  id String @id @default(cuid())
  businessId String
  name String
  platform String
  objective String
  status String @default("draft")
  budget Float?
  spend Float @default(0)
  leads Int @default(0)
  conversions Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId])
}

model BusinessProspect {
  id String @id @default(cuid())
  businessId String
  source String
  externalId String?
  name String
  category String?
  address String?
  city String?
  region String?
  country String?
  postalCode String?
  lat Float?
  lng Float?
  phone String?
  website String?
  status String @default("new")
  collectedAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, city, category])
}

model PaymentLink {
  id String @id @default(cuid())
  businessId String
  name String
  provider String
  amount Float?
  currency String @default("INR")
  url String?
  status String @default("draft")
  createdAt DateTime @default(now())
  @@index([businessId])
}

model AuditLog {
  id String @id @default(cuid())
  businessId String
  userId String?
  action String
  metadata Json?
  createdAt DateTime @default(now())
  @@index([businessId])
}
